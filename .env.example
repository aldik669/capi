# Graph API version used for all projects, e.g. v21.0
GRAPH_API_VERSION=v21.0

# Admin panel credentials (HTTP Basic Auth) protecting /admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Port the Express server listens on
PORT=3000

# Note: per-project settings (PIXEL_ID, ACCESS_TOKEN, TEST_EVENT_CODE) are no
# longer set here — add/edit projects via the admin panel at /admin.
# They are stored in data/projects.db (SQLite).
